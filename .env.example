# EmailJS — baked in at build time (set these on Render before the first deploy)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Postgres — local (no SSL). Render injects DATABASE_URL automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio
DATABASE_SSL=false

# Admin (/admin) — set a strong password on Render (Blueprint will prompt)
ADMIN_PASSWORD=change-me
# At least 32 characters (Render can generate ADMIN_SESSION_SECRET)
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
